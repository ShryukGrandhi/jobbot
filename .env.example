# Copy to .env and fill in.  .env is gitignored.

# ---- Which LLM backend -------------------------------------------------
# "anthropic"  : api.anthropic.com, pay-per-token. The supported path.
# "gemini"     : Google Gemini as the primary. Needs only GEMINI_API_KEY.
# "meridian"   : local proxy bridging a Claude subscription. See README note.
JOBBOT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
JOBBOT_LLM_MODEL=claude-opus-5

# Fallback used when the primary is rate-limited or unreachable.
JOBBOT_LLM_FALLBACK=gemini
GEMINI_API_KEY=
JOBBOT_GEMINI_MODEL=gemini-2.5-pro

# ---- Notifications (optional) ------------------------------------------
# Leave JOBBOT_NOTIFY_TO empty and notifications just go to
# data/notifications.log. Set it to get a message per submission.
JOBBOT_NOTIFY_TO=

# Backends are tried in order: custom command, then macOS Messages, then webhook.
# {to} and {body} are substituted into the command.
# JOBBOT_NOTIFY_CMD=my-sms-tool --to {to} --message {body}
# JOBBOT_NOTIFY_URL=https://example.com/send
# JOBBOT_NOTIFY_TOKEN=

# ---- GitHub (optional, for per-application portfolio projects) ----------
# Falls back to `gh auth token` if unset. Needs the `repo` scope.
# GITHUB_TOKEN=
# GITHUB_OAUTH_CLIENT_ID=

# ---- Browser -----------------------------------------------------------
JOBBOT_MAX_TABS=3
# CLOAKBROWSER_LICENSE_KEY=   # optional; free tier works without it
